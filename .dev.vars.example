# Copy to .dev.vars for local `wrangler pages dev` testing of functions/api/contact.ts.
# In production, set these as Cloudflare Pages environment variables/secrets instead
# (Pages dashboard -> Settings -> Environment variables, or `wrangler pages secret put`).

# EmailJS — service/template IDs and public key match your EmailJS dashboard.
# EMAILJS_PRIVATE_KEY is the "Private Key" from EmailJS Account > Security —
# it authorizes server-side sends and is never exposed to the browser.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
